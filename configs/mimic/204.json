{
  "name": "MIMIC_0204_V3",
  "network": "SiameseResNet1d",
  "DB": "MIMIC",
  "phase": "train",
  "seed": 12345,
  "architecture": {
    "leads": [
      "V3"
    ],
    "fix_feature_dim": true,
    "kernel_size": 3,
    "embedding_dim": 256,
    "dilation_rate": 1
  },
  "training": {
    "batch_size": 256,
    "device": "cuda",
    "dropout_p": 0.11,
    "learning_rate": 0.00029,
    "n_epoch": 15,
    "num_workers": 2,
    "pin_memory": true,
    "patience": 7,
    "rate_validation": 0.2
  },
  "biometrics": {
    "n_train_val": 1359,
    "n_test": 292,
    "split_path": "outputs/downstream/mimic/seed{seed}/splits/horizon365d/split.npz",
    "manifest_path": "outputs/cohorts/mimic/seed{seed}/biometric_cohort.json"
  },
  "input": {
    "ecg": "data/mimic/processed/ecg.h5",
    "labels": "data/mimic/processed/labels.csv"
  }
}
